# LaunchOS — copy to .env.local and fill in what you have. Every variable is optional:
# without model keys the app still runs and shows a graceful "generation unavailable" state.
# Never commit .env.local (it is gitignored).

# --- Models (primary → fallbacks) ---
# Google AI Studio key for the primary model (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
# OpenRouter key for the free-tier fallback models (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=
# Optional overrides, comma-separated (defaults: gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite;
# fallbacks poolside/laguna-s-2.1:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free)
LAUNCHOS_PRIMARY_MODEL=
LAUNCHOS_FALLBACK_MODELS=

# --- Storage (share links + daily budget counter) ---
# Vercel Blob read-write token; without it both use in-memory storage (fine for local use)
BLOB_READ_WRITE_TOKEN=

# --- Limits (public deployments) ---
# Daily live generations (default 25; 0 = unlimited for your own fork)
LAUNCHOS_DAILY_LIVE_RUNS=
# Live generations per client per hour (default 3; 0 = off)
LAUNCHOS_RUNS_PER_CLIENT_HOUR=

# --- Analytics (PostHog, optional) ---
NEXT_PUBLIC_POSTHOG_KEY=
# e.g. https://eu.i.posthog.com or https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=

# --- Visual QA only ---
# 1 enables the demo's ?now= time override in production builds
LAUNCHOS_QA=
