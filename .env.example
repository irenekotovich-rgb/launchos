# Copy to .env.local and fill in. Keys never go in code or in the repo.
GOOGLE_GENERATIVE_AI_API_KEY=   # aistudio.google.com - free tier
OPENROUTER_API_KEY=             # openrouter.ai - fallback chain
NEXT_PUBLIC_POSTHOG_KEY=        # posthog.com - hosted instance only, optional in forks
BLOB_READ_WRITE_TOKEN=          # vercel blob - share links (M3)
DAILY_LIVE_RUN_BUDGET=20        # live generations per day before graceful demo fallback
